# Copy to .env.prod and fill in. Never commit .env.prod.
DOMAIN=intranet.eden.ph
POSTGRES_PASSWORD=CHANGE_ME
# must equal POSTGRES_PASSWORD (Odoo container reads this name)
PASSWORD=CHANGE_ME
# GoDaddy API credentials in the form KEY:SECRET (developer.godaddy.com/keys, Production key)
GODADDY_API_TOKEN=CHANGE_ME_KEY:CHANGE_ME_SECRET
