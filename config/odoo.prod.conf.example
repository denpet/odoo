[options]
addons_path = /mnt/extra-addons/vertical-hotel,/mnt/extra-addons/custom
data_dir = /var/lib/odoo
; master password for database management -- set a long random value
admin_passwd = CHANGE_ME
proxy_mode = True
; database manager disabled; Odoo only serves the database below
list_db = False
db_name = odoo
dbfilter = ^odoo$
; multi-process mode; rule of thumb: workers = (CPU cores * 2) + 1
workers = 4
max_cron_threads = 1
gevent_port = 8072
limit_time_cpu = 600
limit_time_real = 1200
log_level = info
