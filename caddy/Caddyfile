# TEMPORARY until go-live: Odoo is served on port 8069 only. At go-live change this back to
# "{$DOMAIN} {" and the published port in compose.prod.yaml to 443.
{$DOMAIN}:8069 {
	# Let's Encrypt certificate via DNS-01: Caddy creates the _acme-challenge TXT record through
	# the GoDaddy API (token "<key>:<secret>" in .env.prod). Renewed automatically.
	tls {
		dns godaddy {env.GODADDY_API_TOKEN}
		# Check the TXT record on public resolvers: the internal DNS may not serve eden.ph.
		resolvers 1.1.1.1 8.8.8.8
	}
	encode zstd gzip

	# Odoo real-time bus (gevent worker)
	reverse_proxy /websocket odoo:8072

	reverse_proxy odoo:8069
}
