<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- The OCA hotel modules never put anyone in their groups, not even admin; without them the
         Hotel Management app only shows "Pdf Reports". Give admin Manager (implies User).
         Written on the group, not on base.user_admin: that record is noupdate, so changes to it
         are silently skipped when a module is updated. -->
    <record id="hotel.group_hotel_manager" model="res.groups">
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]" />
    </record>
</odoo>
