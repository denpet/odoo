<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_room_form_sirvoy" model="ir.ui.view">
        <field name="name">hotel.room.form.sirvoy</field>
        <field name="model">hotel.room</field>
        <field name="inherit_id" ref="hotel.view_hotel_room_form"/>
        <field name="arch" type="xml">
            <field name="capacity" position="after">
                <field name="sirvoy_room_name"/>
            </field>
        </field>
    </record>

    <record id="view_hotel_folio_form_sirvoy" model="ir.ui.view">
        <field name="name">hotel.folio.form.sirvoy</field>
        <field name="model">hotel.folio</field>
        <field name="inherit_id" ref="hotel.view_hotel_folio_form"/>
        <field name="arch" type="xml">
            <field name="invoice_status" position="after">
                <field name="sirvoy_booking_id" invisible="not sirvoy_booking_id"/>
                <field name="sirvoy_event_id" invisible="not sirvoy_event_id"/>
            </field>
        </field>
    </record>
</odoo>
